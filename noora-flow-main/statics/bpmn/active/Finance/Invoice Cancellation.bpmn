        <camunda:formData>
          <camunda:formField id="PreviousTask" type="object" />
          <camunda:formField id="Assignees" type="object" />
          <camunda:formField id="InformationReviewByAccountantStatus" type="string" />
          <camunda:formField id="InformationReviewByAccountantNote" type="string" />
        </camunda:formData>
        <camunda:properties>
          <camunda:property name="data" value="PreviousTask,Assignees,InvoiceItems" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1kny4mf</bpmn:incoming>
      <bpmn:outgoing>Flow_1dewk7p</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1t0rrjk">
      <bpmn:incoming>Flow_1dewk7p</bpmn:incoming>
      <bpmn:outgoing>Flow_0gozmpo</bpmn:outgoing>
      <bpmn:outgoing>Flow_0uky73g</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1dewk7p" sourceRef="InformationReviewByAccountant" targetRef="Gateway_1t0rrjk" />
    <bpmn:sequenceFlow id="Flow_1kny4mf" sourceRef="InformationForm" targetRef="InformationReviewByAccountant" />
    <bpmn:userTask id="CancellationNotice" name="اطلاع لغو فاکتور" camunda:assignee="$[data.Assignees.creator.id]">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="data" value="PreviousTask,Assignees,InvoiceItems" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0gozmpo</bpmn:incoming>
      <bpmn:outgoing>Flow_03cmx5n</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_1bx565p">
