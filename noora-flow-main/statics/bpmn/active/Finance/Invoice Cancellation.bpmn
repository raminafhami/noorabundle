  <bpmn:process id="Financial_Invoice_Cancellation" name="لغو فاکتور" isExecutable="true">
    <bpmn:extensionElements>
      <camunda:properties>
        <camunda:property name="indicator" value="inspection" />
        <camunda:property name="displayable" value="true" />
        <camunda:property name="stateList" value="[{&#34;name&#34;:&#34;information-form&#34;,&#34;title&#34;:&#34;تکمیل اطلاعات&#34;},{&#34;name&#34;:&#34;information-reviewby-accountant&#34;,&#34;title&#34;:&#34;بررسی اطلاعات (حسابدار)&#34;},{&#34;name&#34;:&#34;cancellation-applied&#34;,&#34;title&#34;:&#34;لغو درخواست اعمال شده&#34;},{&#34;name&#34;:&#34;canceled&#34;,&#34;title&#34;:&#34;لغو شده&#34;}]" />
      </camunda:properties>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_0y8t25y">
      <bpmn:lane id="Lane_0r9e4zf" name="درخواست دهنده">
