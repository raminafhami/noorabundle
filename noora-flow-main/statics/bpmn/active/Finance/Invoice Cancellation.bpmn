        <bpmn:flowNodeRef>CancellationNotice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_1bx565p</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1m2vubh" name="حسابداری">
        <bpmn:flowNodeRef>InformationReviewByAccountant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1t0rrjk</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_0f377ps</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0f377ps" sourceRef="StartEvent_1" targetRef="InformationForm" />
    <bpmn:userTask id="InformationForm" name="تکمیل اطلاعات" camunda:assignee="$[owner]">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="PreviousTask" type="object" />
          <camunda:formField id="Assignees" type="object" />
          <camunda:formField id="CancellationNote" type="object" />
          <camunda:formField id="InformationFormStatus" type="string" />
          <camunda:formField id="InformationFormNote" type="string" />
          <camunda:formField id="InvoiceItems" type="object" />
        </camunda:formData>
        <camunda:properties>
          <camunda:property name="data" value="PreviousTask,Assignees" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0f377ps</bpmn:incoming>
      <bpmn:incoming>Flow_0uky73g</bpmn:incoming>
      <bpmn:outgoing>Flow_1kny4mf</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0uky73g" name="بازگشت" sourceRef="Gateway_1t0rrjk" targetRef="InformationForm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.InformationReviewByAccountantStatus] === "return-creator"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0gozmpo" name="تایید" sourceRef="Gateway_1t0rrjk" targetRef="CancellationNotice">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.InformationReviewByAccountantStatus] === "forward"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="InformationReviewByAccountant" name="بررسی اطلاعات (حسابداری)" camunda:assignee="$[data.Assignees.accountant.id]" camunda:candidateGroups="financial-assistant">
