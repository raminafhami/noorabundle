    <bpmn:sequenceFlow id="Flow_0t4cx81" sourceRef="StartEvent_1" targetRef="PaymentOrderRequest" />
    <bpmn:sequenceFlow id="Flow_0si8cis" sourceRef="isAccept" targetRef="PaymentOrderRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.State]=='reject'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09ksih8" sourceRef="Gateway_1f9cbij" targetRef="PaymentOrderRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.ExpertState]=='requestMaker'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0ukzkh3" sourceRef="PaymentOrderRequest" targetRef="Gateway_0548wy5" />
    <bpmn:sequenceFlow id="Flow_0lsz1pf" sourceRef="PaymentOrderDoc" targetRef="PaymentOrderCompletion" />
    <bpmn:sequenceFlow id="Flow_0vd2wk7" sourceRef="Gateway_1f9cbij" targetRef="Gateway_1jerxdb">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.ExpertState]=='nextStep'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_03jo580" sourceRef="Gateway_1f9cbij" targetRef="PaymentOrderReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.ExpertState]=='manager'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0hzaqy8" sourceRef="Gateway_0548wy5" targetRef="Gateway_1vmo6i5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.IsCancel]=='false'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0wml27s" sourceRef="Gateway_1vmo6i5" targetRef="PaymentOrderReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.Currency] !== 'rial' || (Number($[data.Amount]) &gt; 10000000 &amp;&amp; $[data.Currency] === 'rial') || $[data.ProcessType] === 'beneficiary'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0gbtnf7" sourceRef="Gateway_1vmo6i5" targetRef="PaymentOrderPay">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Number($[data.Amount]) &lt;= 10000000 &amp;&amp; $[data.Currency] === 'rial' &amp;&amp; $[data.ProcessType] !== 'beneficiary'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1g3o60r" sourceRef="PaymentOrderReview" targetRef="Gateway_03920n9" />
    <bpmn:sequenceFlow id="Flow_0qela49" sourceRef="Gateway_0548wy5" targetRef="Event_0uvh36z">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.IsCancel]=='true'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0lyyja2" sourceRef="Gateway_03920n9" targetRef="isAccept">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.IsCancel]=='false'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_04aiysr" sourceRef="isAccept" targetRef="PaymentOrderPay">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.State]=='accept'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0a7wgp0" sourceRef="Gateway_03920n9" targetRef="Event_181ps95">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.IsCancel]=='true'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_1f9cbij">
      <bpmn:incoming>Flow_1elsy1s</bpmn:incoming>
      <bpmn:outgoing>Flow_03jo580</bpmn:outgoing>
      <bpmn:outgoing>Flow_09ksih8</bpmn:outgoing>
      <bpmn:outgoing>Flow_0vd2wk7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1elsy1s" sourceRef="PaymentOrderPay" targetRef="Gateway_1f9cbij" />
    <bpmn:userTask id="PaymentOrderDoc" name="ثبت سند" camunda:candidateGroups="financial-assistant" camunda:priority="$[data.Priority]">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="data" value="UserData,ProcessType,Title,PaymentDate,Priority,Amount,Currency,CurrencyRate,CashPay,InputType,UserInformation,NationalCode,BankAccountsOwner,BankAccountNumber,BankCardNumber,Sheba,CostsIds,PettyCostIds,Description,State,ReviewDes,ExpertState,PayDes" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1yeli4o</bpmn:incoming>
      <bpmn:outgoing>Flow_0lsz1pf</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1jerxdb">
      <bpmn:incoming>Flow_0vd2wk7</bpmn:incoming>
      <bpmn:outgoing>Flow_1yeli4o</bpmn:outgoing>
      <bpmn:outgoing>Flow_08ov38x</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1yeli4o" sourceRef="Gateway_1jerxdb" targetRef="PaymentOrderDoc">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.RemainingAmount]=='0'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08ov38x" sourceRef="Gateway_1jerxdb" targetRef="PaymentOrderPay">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.RemainingAmount]!=='0'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="PaymentOrderCompletion" name="پرداخت شده" camunda:assignee="$[owner]" camunda:priority="$[data.Priority]">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="data" value="UserData,ProcessType,Title,PaymentDate,Priority,Amount,Currency,CurrencyRate,CashPay,InputType,UserInformation,NationalCode,BankAccountsOwner,BankAccountNumber,BankCardNumber,Sheba,CostsIds,PettyCostIds,Description,State,ReviewDes,ExpertState,PayDes" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0lsz1pf</bpmn:incoming>
      <bpmn:outgoing>Flow_04bkpif</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_0tkajjn">
