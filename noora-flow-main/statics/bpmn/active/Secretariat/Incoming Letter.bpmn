  <bpmn:collaboration id="Collaboration_164rr13">
    <bpmn:participant id="Participant_063hi27" processRef="SecretariatIncomingLetter" />
  </bpmn:collaboration>
  <bpmn:process id="SecretariatIncomingLetter" name="نامه وارده" isExecutable="true">
    <bpmn:extensionElements>
      <camunda:properties>
        <camunda:property name="indicator" value="letter" />
        <camunda:property name="displayable" value="true" />
        <camunda:property name="documents" value="{&#34;types&#34;: {&#34;letter&#34;: {&#34;title&#34;: &#34;نامه&#34;,&#34;extensions&#34;: [&#34;jpg&#34;, &#34;jpeg&#34;, &#34;png&#34;, &#34;doc&#34;, &#34;docx&#34;, &#34;pdf&#34;],&#34;multiple&#34;: true}},&#34;folders&#34;: {&#34;letters&#34;: {&#34;title&#34;: &#34;نامه ها&#34;,&#34;types&#34;: [&#34;letter&#34;]}}}" />
      </camunda:properties>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_0sxth5m">
      <bpmn:lane id="Lane_09or9wt" name="دبیرخانه">
        <bpmn:flowNodeRef>Event_0ebgpqz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1w124l1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LetterFormByAuthor</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_0w3mk0x" name="مسئول نامه">
        <bpmn:flowNodeRef>Gateway_0n0icd0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LetterReviewByManager</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:endEvent id="Event_0ebgpqz">
      <bpmn:incoming>Flow_0by4liw</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_1w124l1">
      <bpmn:incoming>Flow_10057vx</bpmn:incoming>
      <bpmn:outgoing>Flow_1r7zydl</bpmn:outgoing>
      <bpmn:outgoing>Flow_0by4liw</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_0fs8o94</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_0n0icd0">
      <bpmn:incoming>Flow_1p1i6te</bpmn:incoming>
      <bpmn:outgoing>Flow_10057vx</bpmn:outgoing>
      <bpmn:outgoing>Flow_0sorqa7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0fs8o94" sourceRef="StartEvent_1" targetRef="LetterFormByAuthor" />
    <bpmn:sequenceFlow id="Flow_1r7zydl" name="بازگشت به ایجاد کننده" sourceRef="Gateway_1w124l1" targetRef="LetterFormByAuthor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.LetterReviewByManagerStatus] == "return"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0sli2bb" sourceRef="LetterFormByAuthor" targetRef="LetterReviewByManager" />
    <bpmn:sequenceFlow id="Flow_0by4liw" name="تایید" sourceRef="Gateway_1w124l1" targetRef="Event_0ebgpqz">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.LetterReviewByManagerStatus] == "confirm"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10057vx" name="تایید" sourceRef="Gateway_0n0icd0" targetRef="Gateway_1w124l1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.Reassign] == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1p1i6te" sourceRef="LetterReviewByManager" targetRef="Gateway_0n0icd0" />
    <bpmn:sequenceFlow id="Flow_0sorqa7" name="انتصاب به دیگری" sourceRef="Gateway_0n0icd0" targetRef="LetterReviewByManager">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.Reassign] == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="LetterFormByAuthor" name="بارگذاری نامه" camunda:assignee="$[owner]">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="Assignees" type="object" />
          <camunda:formField id="LetterFormByAuthorNote" type="string" />
          <camunda:formField id="LetterPriority" type="string" />
          <camunda:formField id="LetterConfidentiality" type="string" />
          <camunda:formField id="LetterFromName" type="string" />
          <camunda:formField id="LetterSubject" type="string" />
          <camunda:formField id="LetterHasAttachments" type="boolean" />
          <camunda:formField id="LetterDate" type="date" />
          <camunda:formField id="LetterFormByAuthorStatus" type="string" />
        </camunda:formData>
        <camunda:properties>
          <camunda:property name="data" value="Assignees,LetterReviewByManagerStatus,LetterReviewByManagerNote" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0fs8o94</bpmn:incoming>
      <bpmn:incoming>Flow_1r7zydl</bpmn:incoming>
      <bpmn:outgoing>Flow_0sli2bb</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="LetterReviewByManager" name="بررسی نامه" camunda:assignee="$[data.Assignees.Manager.id]">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="data" value="Assignees,LetterFormByAuthorNote,LetterPriority,LetterConfidentiality,LetterFromName,LetterSubject,LetterHasAttachments,LetterDate,LetterFormByAuthorStatus" />
        </camunda:properties>
        <camunda:formData>
          <camunda:formField id="Assignees" type="object" />
          <camunda:formField id="LetterReviewByManagerStatus" type="string" />
          <camunda:formField id="LetterReviewByManagerNote" type="string" />
          <camunda:formField id="LetterNo" type="string" />
          <camunda:formField id="LetterSignature" type="string" />
          <camunda:formField id="Reassign" type="boolean" />
          <camunda:formField id="ReviewHistory" type="object" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0sli2bb</bpmn:incoming>
      <bpmn:incoming>Flow_0sorqa7</bpmn:incoming>
      <bpmn:outgoing>Flow_1p1i6te</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
