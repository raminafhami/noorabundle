    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_06dv1x6">
      <bpmn:incoming>Flow_1h97twh</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="LetterReview" name="بررسی نامه" camunda:assignee="$[data.Assignees.reviewer.id]">
      <bpmn:extensionElements>
        <camunda:formData>
