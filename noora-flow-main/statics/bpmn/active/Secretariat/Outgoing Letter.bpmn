        <bpmn:flowNodeRef>Event_06dv1x6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LetterReview</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="Flow_138xkcg" sourceRef="StartEvent_1" targetRef="LetterForm" />
    <bpmn:sequenceFlow id="Flow_1vios0u" sourceRef="LetterForm" targetRef="LetterReview" />
    <bpmn:userTask id="LetterForm" name="نوشتن نامه" camunda:assignee="$[owner]">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="PreviousTask" type="object" />
          <camunda:formField id="Assignees" type="object" />
          <camunda:formField id="LetterFormStatus" type="string" />
          <camunda:formField id="LetterFormNote" type="string" />
          <camunda:formField id="LetterPriority" type="string" />
          <camunda:formField id="LetterConfidentiality" type="string" />
          <camunda:formField id="LetterDate" type="date" />
          <camunda:formField id="LetterTo" type="string" />
          <camunda:formField id="LetterSubject" type="string" />
          <camunda:formField id="LetterContent" type="string" />
          <camunda:formField id="LetterHasAttachments" type="boolean" />
          <camunda:formField id="RelatedInspectionCaseNo" type="object" />
          <camunda:formField id="LetterFollowingOfs" type="string" />
          <camunda:formField id="SendType" type="string" />
          <camunda:formField id="Recipients" type="object" />
          <camunda:formField id="NeedsToBeArchived" type="boolean" />
          <camunda:formField id="ReviewBy" type="object" />
        </camunda:formData>
        <camunda:properties>
          <camunda:property name="data" value="Assignees,LetterReviewByManagerNote,LetterReviewByManagerStatus" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_138xkcg</bpmn:incoming>
      <bpmn:incoming>Flow_0qe6mb7</bpmn:incoming>
      <bpmn:outgoing>Flow_1vios0u</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_138xkcg</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0qe6mb7" name="بازگشت" sourceRef="Gateway_075tgjn" targetRef="LetterForm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.LetterReviewStatus] === "return"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_075tgjn">
      <bpmn:incoming>Flow_1s5hu52</bpmn:incoming>
      <bpmn:outgoing>Flow_0kw36wt</bpmn:outgoing>
      <bpmn:outgoing>Flow_1h97twh</bpmn:outgoing>
