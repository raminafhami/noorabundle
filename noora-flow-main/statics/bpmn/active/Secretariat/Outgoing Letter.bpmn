          <camunda:formField id="LetterSubject" type="string" />
          <camunda:formField id="LetterContent" type="string" />
          <camunda:formField id="LetterHasAttachments" type="boolean" />
          <camunda:formField id="RelatedInspectionCaseNo" type="string" />
          <camunda:formField id="LetterFollowingOfs" type="object" />
          <camunda:formField id="SendType" type="string" />
          <camunda:formField id="Recipients" type="object" />
          <camunda:formField id="NeedsToBeArchived" type="string" />
          <camunda:formField id="ReviewBy" type="object" />
          <camunda:formField id="ReviewerPosition" type="object" />
        </camunda:formData>
        <camunda:properties>
          <camunda:property name="data" value="Assignees,LetterFormByAuthorNote,LetterFormByAuthorStatus" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1vios0u</bpmn:incoming>
      <bpmn:incoming>Flow_0kw36wt</bpmn:incoming>
      <bpmn:outgoing>Flow_1s5hu52</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1s5hu52" sourceRef="LetterReview" targetRef="Gateway_075tgjn" />
    <bpmn:sequenceFlow id="Flow_0kw36wt" name="انتصاب به دیگری" sourceRef="Gateway_075tgjn" targetRef="LetterReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.LetterReviewStatus] === "reassign"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1h97twh" name="تایید " sourceRef="Gateway_075tgjn" targetRef="Event_06dv1x6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.LetterReviewStatus] === "forward"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
