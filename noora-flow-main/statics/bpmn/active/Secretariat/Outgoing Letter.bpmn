  <bpmn:collaboration id="Collaboration_12yipan">
    <bpmn:participant id="Participant_085zxrx" processRef="Secretariat_Letter_Outgoing" />
  </bpmn:collaboration>
  <bpmn:process id="Secretariat_Letter_Outgoing" name="نامه صادره" isExecutable="true">
    <bpmn:extensionElements>
      <camunda:properties>
        <camunda:property name="indicator" value="inspection" />
        <camunda:property name="displayable" value="true" />
        <camunda:property name="documents" value="{&#34;types&#34;: {&#34;attachment&#34;: {&#34;title&#34;: &#34;پیوست&#34;,&#34;extensions&#34;: [&#34;jpg&#34;, &#34;jpeg&#34;, &#34;png&#34;, &#34;doc&#34;, &#34;docx&#34;, &#34;pdf&#34;],&#34;multiple&#34;: true}},&#34;folders&#34;: {&#34;attachments&#34;: {&#34;title&#34;: &#34;پیوست ها&#34;,&#34;types&#34;: [&#34;attachment&#34;]}}}" />
        <camunda:property name="stateList" value="[{&#34;name&#34;:&#34;letter-form&#34;,&#34;title&#34;:&#34;نوشتن نامه&#34;},{&#34;name&#34;:&#34;letter-review&#34;,&#34;title&#34;:&#34;بررسی نامه&#34;},{&#34;name&#34;:&#34;completed&#34;,&#34;title&#34;:&#34;تکمیل شده&#34;},{&#34;name&#34;:&#34;canceled&#34;,&#34;title&#34;:&#34;لغو شده&#34;}]" />
      </camunda:properties>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1uq663o">
      <bpmn:lane id="Lane_0hkeu9r" name="Creator">
        <bpmn:flowNodeRef>LetterForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_11w5oj8" name="Reviewer">
