      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ljkbsu</bpmn:incoming>
      <bpmn:outgoing>Flow_0qametr</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_12sg981</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="Event_13qxv4z">
      <bpmn:incoming>Flow_19om9lb</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="ExtraFields" name="فیلدهای اضافه">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="InspectionExpert" label="کارشناس" type="string" />
          <camunda:formField id="Packing" label="پکینگ" type="string" />
          <camunda:formField id="InspectionType" label="نوع بازرسی" type="string" />
          <camunda:formField id="InspectionCaseNo" label="شماره فایل" type="string" />
          <camunda:formField id="InspectionInstanceId" label="تسک" type="string" />
          <camunda:formField id="BuyerName" label="خریدار" type="string" />
          <camunda:formField id="DescriptionOfGoods" label="شرح کالا" type="string" />
          <camunda:formField id="FieldOfGoods" label="دامنه بازرسی" type="string" />
          <camunda:formField id="ProformaNo" label="شماره پروفرما" type="string" />
          <camunda:formField id="ProformaDate" label="تاریخ پروفرما" type="string" />
          <camunda:formField id="DischargerName" label="نام ترخیص کار " type="string" />
          <camunda:formField id="DischargerPhoneNo" label="شماره ترخیص کار" type="string" />
          <camunda:formField id="InspectionExpertName" type="string" />
          <camunda:formField id="CustomName" type="string" />
          <camunda:formField id="InspectionMethod" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_12sg981" sourceRef="StartEvent_1" targetRef="InspectorSelection" />
    <bpmn:sequenceFlow id="Flow_0vyharw" sourceRef="InspectorSelection" targetRef="InspectorProcess" />
    <bpmn:sequenceFlow id="Flow_1hfo95v" sourceRef="Gateway_0pvxrva" targetRef="InspectorProcess">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.Status]=='reject'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1ljkbsu" sourceRef="InspectorProcess" targetRef="InspectionValidate" />
    <bpmn:sequenceFlow id="Flow_0qametr" sourceRef="InspectionValidate" targetRef="Gateway_0pvxrva" />
    <bpmn:sequenceFlow id="Flow_19om9lb" sourceRef="Gateway_0pvxrva" targetRef="Event_13qxv4z">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.Status]=='accept'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
