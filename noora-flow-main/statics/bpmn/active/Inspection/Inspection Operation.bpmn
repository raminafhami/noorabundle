<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1ayv9hr" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.25.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.20.0">
  <bpmn:collaboration id="Collaboration_07j46vh">
    <bpmn:extensionElements />
    <bpmn:participant id="InspectorsProcess" name="فرایند بازرسی" processRef="Inspectors" />
  </bpmn:collaboration>
  <bpmn:process id="Inspectors" name="فرایند بازرسی" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:extensionElements>
      <camunda:properties>
        <camunda:property name="displayable" value="false" />
        <camunda:property name="indicator" value="inspectors" />
        <camunda:property name="documents" value="{&#34;types&#34;:{&#34;packing_list&#34;:{&#34;title&#34;:&#34;پکینگ لیست / PACKING LIST&#34;,&#34;extensions&#34;:[&#34;pdf&#34;],&#34;multiple&#34;:false},&#34;warehouse_receipt&#34;:{&#34;title&#34;:&#34;قبض انبار / WAREHOUSE RECEIPT&#34;,&#34;extensions&#34;:[&#34;pdf&#34;],&#34;multiple&#34;:false},&#34;misc&#34;:{&#34;title&#34;:&#34;سایر&#34;,&#34;extensions&#34;:[&#34;pdf&#34;],&#34;multiple&#34;:true}},&#34;folders&#34;:{&#34;docs&#34;:{&#34;title&#34;:&#34;اسناد / DOCS&#34;,&#34;types&#34;:[&#34;packing_list&#34;,&#34;warehouse_receipt&#34;,&#34;misc&#34;]},&#34;scanned_docs&#34;:{&#34;title&#34;:&#34;اسناد اسکن شده / SCANNED DOCS&#34;,&#34;types&#34;:[&#34;misc&#34;]}}}" />
        <camunda:property name="stateList" value="[{&#34;name&#34;:&#34;inspection-planning&#34;,&#34;title&#34;:&#34;هماهنگی بازرسی&#34;},{&#34;name&#34;:&#34;inspection-operation&#34;,&#34;title&#34;:&#34;انجام بازرسی&#34;},{&#34;name&#34;:&#34;inspection-review&#34;,&#34;title&#34;:&#34;بررسی نتایج بازرسی&#34;}]" />
      </camunda:properties>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1951b1w">
      <bpmn:lane id="InceptionExpert" name="کارشناس">
        <bpmn:flowNodeRef>InspectorSelection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InspectionValidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExtraFields</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Inspector" name="بازرس">
        <bpmn:flowNodeRef>InspectorProcess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0pvxrva</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_13qxv4z</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="InspectorSelection" name="انتخاب بازرس" camunda:assignee="$[data.InspectionExpert]">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="data" value="InspectionCaseNo,InspectionInstanceId,InspectionType,BuyerName,DescriptionOfGoods,FieldOfGoods,ProformaNo,ProformaDate,DischargerName,DischargerPhoneNo,InspectionExpert,Packing,Seller,InspectionTools,QuantityReport,PackingReport,LoadingReport,Quantity,QuantityDes,Appearence,AppearenceDes,MarketingLabel,MarketingLabelDes,Testing,TestingDes,InspectorName,Description,Status,ReferenceNumber,QuantityControl,InspectionOverall,Latitude,Longitude,InspectionExpert,InspectorAssignee,InspectionExpertName,ScheduleDate,CustomName,InspectionMethod" />
        </camunda:properties>
        <camunda:formData>
          <camunda:formField id="InspectorAssignee" label="بازرس" type="string" />
          <camunda:formField id="InspectorName" label="نام بازرس" type="string" />
          <camunda:formField id="Inspectortype" label="نوع بازرس" type="string" />
          <camunda:formField id="InspectorPhone" label="شماره بازرس" type="string" />
          <camunda:formField id="ReferenceNumber" type="string" />
          <camunda:formField id="ScheduleDate" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_12sg981</bpmn:incoming>
      <bpmn:outgoing>Flow_0vyharw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="InspectorProcess" name="بازرسی" camunda:assignee="$[data.InspectorAssignee]">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="data" value="InspectionCaseNo,InspectionInstanceId,InspectionType,BuyerName,DescriptionOfGoods,FieldOfGoods,ProformaNo,ProformaDate,DischargerName,DischargerPhoneNo,InspectionExpert,Packing,Seller,InspectionTools,QuantityReport,PackingReport,LoadingReport,Quantity,QuantityDes,Appearence,AppearenceDes,MarketingLabel,MarketingLabelDes,Testing,TestingDes,InspectorName,Description,Status,ReferenceNumber,QuantityControl,InspectionOverall,Latitude,Longitude,InspectionExpert,InspectorAssignee,InspectionExpertName,RejectDescriptionList,ScheduleDate,CustomName,InspectionMethod" />
        </camunda:properties>
        <camunda:formData>
          <camunda:formField id="Seller" type="string" />
          <camunda:formField id="InspectionTools" type="string" />
          <camunda:formField id="QuantityReport" type="string" />
          <camunda:formField id="PackingReport" type="string" />
          <camunda:formField id="LoadingReport" type="string" />
          <camunda:formField id="Quantity" type="string" />
          <camunda:formField id="QuantityDes" type="string" />
          <camunda:formField id="Appearence" type="string" />
          <camunda:formField id="AppearenceDes" type="string" />
          <camunda:formField id="MarketingLabel" type="string" />
          <camunda:formField id="MarketingLabelDes" type="string" />
          <camunda:formField id="Testing" type="string" />
          <camunda:formField id="TestingDes" type="string" />
          <camunda:formField id="QuantityControl" type="object" />
          <camunda:formField id="Description" type="string" />
          <camunda:formField id="InspectionOverall" type="string" />
          <camunda:formField id="Longitude" type="string" />
          <camunda:formField id="Latitude" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0vyharw</bpmn:incoming>
      <bpmn:incoming>Flow_1hfo95v</bpmn:incoming>
      <bpmn:outgoing>Flow_1ljkbsu</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_0pvxrva">
      <bpmn:incoming>Flow_0qametr</bpmn:incoming>
      <bpmn:outgoing>Flow_19om9lb</bpmn:outgoing>
      <bpmn:outgoing>Flow_1hfo95v</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="InspectionValidate" name="تایید بازرسی" camunda:assignee="$[data.InspectionExpert]">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="data" value="InspectionCaseNo,InspectionInstanceId,InspectionType,BuyerName,DescriptionOfGoods,FieldOfGoods,ProformaNo,ProformaDate,DischargerName,DischargerPhoneNo,InspectionExpert,Packing,Seller,InspectionTools,QuantityReport,PackingReport,LoadingReport,Quantity,QuantityDes,Appearence,AppearenceDes,MarketingLabel,MarketingLabelDes,Testing,TestingDes,InspectorName,Description,Status,ReferenceNumber,QuantityControl,InspectionOverall,Latitude,Longitude,InspectionExpert,InspectorAssignee,InspectionExpertName,RejectDescriptionList,ScheduleDate,CustomName,InspectionMethod" />
        </camunda:properties>
        <camunda:formData>
          <camunda:formField id="Status" type="string" />
          <camunda:formField id="RejectDescriptionList" label="توضیحات بازرسی مجدد" type="object" />
