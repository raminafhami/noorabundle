    <bpmn:endEvent id="Event_0jscxre">
      <bpmn:incoming>Flow_0fs6ydq</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0k39pb0" name="بازگشت" sourceRef="Gateway_1a24lso" targetRef="PaymentForm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.PaymentReviewStatus] == 'return'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_19596sh" sourceRef="PaymentForm" targetRef="Gateway_0idltfw" />
    <bpmn:sequenceFlow id="Flow_03bbsnb" sourceRef="PaymentReview" targetRef="Gateway_1jznaor" />
    <bpmn:sequenceFlow id="Flow_1n0ibm7" name="ثبت وصول" sourceRef="Gateway_1677ryp" targetRef="PaymentReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.ActionName] === 'receipt'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0pcc2bt" name="تایید" sourceRef="Gateway_0idltfw" targetRef="Gateway_1677ryp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.PaymentFormStatus] === 'forward'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0bze5jx" name="دریافت فاکتور" sourceRef="Gateway_1677ryp" targetRef="PaymentIssue">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.ActionName] === 'invoice'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0fs6ydq" name="لغو" sourceRef="Gateway_0idltfw" targetRef="Event_0jscxre">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.PaymentFormStatus] === 'cancel'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_0v8ydo7">
      <bpmn:incoming>Flow_0e48npm</bpmn:incoming>
      <bpmn:outgoing>Flow_1ka776l</bpmn:outgoing>
      <bpmn:outgoing>Flow_0pw1wjc</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1ka776l" sourceRef="Gateway_0v8ydo7" targetRef="PaymentForm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.PaymentType] !== "bank-gateway"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0pw1wjc" name="درگاه بانکی" sourceRef="Gateway_0v8ydo7" targetRef="PaymentReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.PaymentType] === "bank-gateway"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_1a24lso">
      <bpmn:incoming>Flow_13960vx</bpmn:incoming>
      <bpmn:outgoing>Flow_0k39pb0</bpmn:outgoing>
      <bpmn:outgoing>Flow_0pilszy</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0pilszy" name="تایید" sourceRef="Gateway_1a24lso" targetRef="PaymentIssue">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.PaymentReviewStatus] == 'confirm'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12hck4e" sourceRef="PaymentIssue" targetRef="Event_165axrb" />
    <bpmn:exclusiveGateway id="Gateway_1jznaor">
