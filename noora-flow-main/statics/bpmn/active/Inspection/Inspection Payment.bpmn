    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0e48npm" sourceRef="StartEvent_1" targetRef="Gateway_0v8ydo7" />
    <bpmn:userTask id="PaymentForm" name="تکمیل اطلاعات اولیه" camunda:assignee="$[owner]">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="ActionName" type="string" />
          <camunda:formField id="Assignees" type="object" />
          <camunda:formField id="BankAccount" type="string" />
          <camunda:formField id="CaseItems" type="object" />
          <camunda:formField id="CaseType" type="string" />
          <camunda:formField id="IsCaseActionsAllowed" type="string" />
          <camunda:formField id="PayerSepidarId" type="string" />
          <camunda:formField id="PaymentAmount" type="string" />
          <camunda:formField id="PaymentDate" type="string" />
          <camunda:formField id="PaymentFormNote" type="string" />
          <camunda:formField id="PaymentFormStatus" type="string" />
          <camunda:formField id="PaymentType" type="string" />
          <camunda:formField id="ReceiptNo" type="string" />
        </camunda:formData>
        <camunda:properties>
          <camunda:property name="data" value="ActionName,Assignees,BankAccount,CaseItems,CaseType,IsCaseActionsAllowed,PayerSepidarId,PaymentAmount,PaymentDate,PaymentFormNote,PaymentFormStatus,PaymentReviewStatus,PaymentReviewNote,PaymentType,ReceiptNo" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0k39pb0</bpmn:incoming>
      <bpmn:incoming>Flow_1ka776l</bpmn:incoming>
      <bpmn:outgoing>Flow_19596sh</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_1ndc7m4" name="فیلدهای مدیریتی">
      <bpmn:extensionElements>
        <camunda:formData />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="PaymentReview" name="بررسی وجه دریافتی" camunda:assignee="$[data.Assignees.financialExpert.id]" camunda:candidateGroups="financial-assistant">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="data" value="Assignees,BankAccount,CaseItems,CaseType,PayerSepidarId,PaymentAmount,PaymentDate,PaymentFormNote,PaymentReviewStatus,PaymentReviewNote,PaymentType,ReceiptNo" />
        </camunda:properties>
        <camunda:formData>
          <camunda:formField id="Assignees" type="object" />
          <camunda:formField id="CaseItems" type="object" />
          <camunda:formField id="PaymentReviewNote" type="string" />
          <camunda:formField id="PaymentReviewStatus" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1n0ibm7</bpmn:incoming>
      <bpmn:incoming>Flow_0pw1wjc</bpmn:incoming>
      <bpmn:outgoing>Flow_03bbsnb</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1677ryp">
      <bpmn:incoming>Flow_0pcc2bt</bpmn:incoming>
      <bpmn:outgoing>Flow_1n0ibm7</bpmn:outgoing>
      <bpmn:outgoing>Flow_0bze5jx</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_0idltfw">
      <bpmn:incoming>Flow_19596sh</bpmn:incoming>
