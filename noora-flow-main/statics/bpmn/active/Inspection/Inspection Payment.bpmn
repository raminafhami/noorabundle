    <bpmn:sequenceFlow id="Flow_13960vx" sourceRef="Gateway_1jznaor" targetRef="Gateway_1a24lso">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.PaymentType] !== "bank-gateway"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0ob3qnc" name="درگاه بانکی" sourceRef="Gateway_1jznaor" targetRef="PaymentIssue">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.PaymentType] === "bank-gateway"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="PaymentIssue" name="صدور فاکتور / سند" camunda:assignee="$[data.Assignees.financialExpert.id]" camunda:candidateGroups="financial-assistant">
