  <bpmn:process id="ImamSampling" name="ثبت نمونه برداری (امام خمینی (ره))" isExecutable="true" camunda:candidateStarterGroups="ika" camunda:historyTimeToLive="180">
    <bpmn:extensionElements>
      <camunda:properties>
        <camunda:property name="displayable" value="true" />
        <camunda:property name="indicator" value="inspection" />
        <camunda:property name="documents" value="{&#34;types&#34;:{&#34;documents&#34;:{&#34;title&#34;:&#34;مدارک نمونه برداری&#34;,&#34;extensions&#34;:[&#34;png&#34;,&#34;pdf&#34;,&#34;jpg&#34;,&#34;jpeg&#34;],&#34;multiple&#34;:true},&#34;paymentReceipt&#34;:{&#34;title&#34;:&#34;رسید پرداخت&#34;,&#34;extensions&#34;:[&#34;png&#34;,&#34;pdf&#34;,&#34;jpg&#34;,&#34;jpeg&#34;],&#34;multiple&#34;:false},&#34;samplingForm&#34;:{&#34;title&#34;:&#34;فرم گمرکی&#34;,&#34;extensions&#34;:[&#34;png&#34;,&#34;pdf&#34;,&#34;jpg&#34;,&#34;jpeg&#34;],&#34;multiple&#34;:true}},&#34;folders&#34;:{&#34;documents&#34;:{&#34;title&#34;:&#34;مدارک نمونه برداری&#34;,&#34;types&#34;:[&#34;documents&#34;]},&#34;paymentReceipt&#34;:{&#34;title&#34;:&#34;رسید پرداخت&#34;,&#34;types&#34;:[&#34;paymentReceipt&#34;]},&#34;samplingForm&#34;:{&#34;title&#34;:&#34;فرم گمرکی&#34;,&#34;types&#34;:[&#34;samplingForm&#34;]}}}" />
