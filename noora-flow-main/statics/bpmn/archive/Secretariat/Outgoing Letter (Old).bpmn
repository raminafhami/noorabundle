    <bpmn:sequenceFlow id="Flow_11ebck5" name="بازگشت به ایجاد کننده" sourceRef="Gateway_0mxwj4d" targetRef="LetterFormByAuthor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.LetterReviewByManagerStatus] == "returned"</bpmn:conditionExpression>
