    <bpmn:sequenceFlow id="Flow_1osqdwo" sourceRef="LetterViewByAuthor" targetRef="Gateway_1dheu0x" />
    <bpmn:sequenceFlow id="Flow_0gvjy72" sourceRef="Gateway_11lcw05" targetRef="Gateway_1dheu0x">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">!$[data.SendType] &amp;&amp; $[data.NeedsToBeArchived] == "no"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0ycxamf" sourceRef="Gateway_1dheu0x" targetRef="Event_1wbex18" />
    <bpmn:sequenceFlow id="Flow_0rxxlha" sourceRef="LetterReviewByManager" targetRef="Gateway_0mxwj4d" />
    <bpmn:sequenceFlow id="Flow_0fh27a6" name="لغو" sourceRef="Gateway_0mxwj4d" targetRef="Event_196exxd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.LetterReviewByManagerStatus] == "canceled"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1uwusd8" name="ارسال به مدیریت" sourceRef="Gateway_0mxwj4d" targetRef="LetterReviewByDirector">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.LetterReviewByManagerStatus] == "pending"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1slt1v3" sourceRef="LetterReviewByDirector" targetRef="LetterReviewByManager" />
    <bpmn:sequenceFlow id="Flow_0j52ka7" sourceRef="Gateway_11lcw05" targetRef="LetterArchiveBySecretary">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$[data.SendType] || $[data.NeedsToBeArchived] == "yes"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
