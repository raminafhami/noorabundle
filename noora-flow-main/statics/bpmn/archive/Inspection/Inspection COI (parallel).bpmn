  <bpmn:process id="Inspection_Case_COI" name="بازرسی COI" isExecutable="true" camunda:candidateStarterGroups="coordinator,coi-admin">
    <bpmn:extensionElements>
      <camunda:properties>
        <camunda:property name="documents" value="{&#34;types&#34;:{&#34;contract&#34;:{&#34;title&#34;:&#34;قرارداد بازرسی / CONTRACT&#34;,&#34;extensions&#34;:[&#34;docx&#34;,&#34;pdf&#34;],&#34;multiple&#34;:false},&#34;proforma&#34;:{&#34;title&#34;:&#34;پروفرما / PROFORMA INVOICE&#34;,&#34;extensions&#34;:[&#34;docx&#34;,&#34;pdf&#34;],&#34;multiple&#34;:false},&#34;invoice&#34;:{&#34;title&#34;:&#34;اینویس / COMMERCIAL INVOICE&#34;,&#34;extensions&#34;:[&#34;docx&#34;,&#34;pdf&#34;],&#34;multiple&#34;:false},&#34;packing_list&#34;:{&#34;title&#34;:&#34;پکینگ لیست / PACKING LIST&#34;,&#34;extensions&#34;:[&#34;docx&#34;,&#34;pdf&#34;],&#34;multiple&#34;:false},&#34;bill_of_lading&#34;:{&#34;title&#34;:&#34;بارنامه / ORIGINAL (MBL/HBL)&#34;,&#34;extensions&#34;:[&#34;docx&#34;,&#34;pdf&#34;],&#34;multiple&#34;:false},&#34;certificate_of_origin&#34;:{&#34;title&#34;:&#34;گواهی مبدا / CERTIFICATE OF ORIGIN&#34;,&#34;extensions&#34;:[&#34;docx&#34;,&#34;pdf&#34;],&#34;multiple&#34;:false},&#34;registration_order&#34;:{&#34;title&#34;:&#34;ثبت سفارش / REGISTRATION ORDER&#34;,&#34;extensions&#34;:[&#34;docx&#34;,&#34;pdf&#34;],&#34;multiple&#34;:false},&#34;delivery_order&#34;:{&#34;title&#34;:&#34;اعلامیه ورود / DELIVERY ORDERS&#34;,&#34;extensions&#34;:[&#34;docx&#34;,&#34;pdf&#34;],&#34;multiple&#34;:false},&#34;warehouse_receipt&#34;:{&#34;title&#34;:&#34;قبض انبار / WAREHOUSE RECEIPT&#34;,&#34;extensions&#34;:[&#34;docx&#34;,&#34;pdf&#34;],&#34;multiple&#34;:false},&#34;inspection_pic&#34;:{&#34;title&#34;:&#34;عکس بازرسی / INSPECTION&#34;,&#34;extensions&#34;:[&#34;jpg&#34;,&#34;jpeg&#34;,&#34;png&#34;],&#34;multiple&#34;:true},&#34;inspection_certificate&#34;:{&#34;title&#34;:&#34;گواهی بازرسی / INSPECTION CERTIFICATE&#34;,&#34;extensions&#34;:[&#34;docx&#34;,&#34;pdf&#34;],&#34;multiple&#34;:false},&#34;test_report&#34;:{&#34;title&#34;:&#34;گزارش بازرسی / TEST REPORT&#34;,&#34;extensions&#34;:[&#34;docx&#34;,&#34;pdf&#34;,&#34;zip&#34;],&#34;multiple&#34;:true},&#34;manufacturer_declaration&#34;:{&#34;title&#34;:&#34;گواهی سازنده / MANUFACTURER&#39;S DECLARATION&#34;,&#34;extensions&#34;:[&#34;docx&#34;,&#34;pdf&#34;,&#34;zip&#34;],&#34;multiple&#34;:true},&#34;payment&#34;:{&#34;title&#34;:&#34;پرداخت / PAYMENT&#34;,&#34;extensions&#34;:[&#34;jpg&#34;,&#34;jpeg&#34;,&#34;png&#34;,&#34;pdf&#34;],&#34;multiple&#34;:true},&#34;misc&#34;:{&#34;title&#34;:&#34;سایر&#34;,&#34;extensions&#34;:[&#34;jpg&#34;,&#34;jpeg&#34;,&#34;png&#34;,&#34;docx&#34;,&#34;pdf&#34;,&#34;zip&#34;],&#34;multiple&#34;:true}},&#34;folders&#34;:{&#34;contract&#34;:{&#34;title&#34;:&#34;قرارداد / CONTRACT&#34;,&#34;types&#34;:[&#34;contract&#34;]},&#34;docs&#34;:{&#34;title&#34;:&#34;اسناد / DOCS&#34;,&#34;types&#34;:[&#34;proforma&#34;,&#34;invoice&#34;,&#34;packing_list&#34;,&#34;bill_of_lading&#34;,&#34;certificate_of_origin&#34;,&#34;registration_order&#34;,&#34;delivery_order&#34;,&#34;warehouse_receipt&#34;,&#34;misc&#34;]},&#34;history&#34;:{&#34;title&#34;:&#34;پیشینه / HISTORY&#34;,&#34;types&#34;:[&#34;misc&#34;]},&#34;ivr&#34;:{&#34;title&#34;:&#34;گزارش تایید بازرسی / IVR&#34;,&#34;types&#34;:[&#34;misc&#34;]},&#34;payment&#34;:{&#34;title&#34;:&#34;پرداخت / PAYMENT&#34;,&#34;types&#34;:[&#34;payment&#34;]},&#34;pic&#34;:{&#34;title&#34;:&#34;عکس ها / PICS&#34;,&#34;types&#34;:[&#34;inspection_pic&#34;]},&#34;scanned_docs&#34;:{&#34;title&#34;:&#34;اسناد اسکن شده / SCANNED DOCS&#34;,&#34;types&#34;:[&#34;inspection_certificate&#34;,&#34;misc&#34;]},&#34;tr_md&#34;:{&#34;title&#34;:&#34;گزارش بازرسی/گواهی سازنده / TR/MD&#34;,&#34;types&#34;:[&#34;test_report&#34;,&#34;manufacturer_declaration&#34;]}}}" />
