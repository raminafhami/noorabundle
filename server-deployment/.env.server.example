# Copy this file to .env.server and replace every CHANGE_ME value.
IMAGE_TAG=1.0.0
BIND_IP=127.0.0.1
FRONTEND_PORT=3000
BACKEND_PORT=4000
PUBLIC_APP_URL=https://app.example.com
PUBLIC_API_URL=https://api.example.com

APP_NAME=apk
APP_ENCRYPTION_SECRET=CHANGE_ME_RANDOM_64_CHARS
SWAGGER_USERNAME=CHANGE_ME
SWAGGER_PASSWORD=CHANGE_ME
MONGO_ROOT_USERNAME=apk_root
MONGO_ROOT_PASSWORD=CHANGE_ME_RANDOM_MONGO_PASSWORD
MONGO_DATABASE=apk
ELASTIC_PASSWORD=CHANGE_ME_RANDOM_ELASTIC_PASSWORD
ES_JAVA_OPTS=-Xms512m -Xmx512m
JWT_ACCESS_TOKEN_EXPIREIN=15m
JWT_REFRESH_TOKEN_EXPIREIN=30d
JWT_ISSUER=apk
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS
JWT_AUDIENCE=apk-users
BPMN_DEFINITIONS_PATH=statics/bpmn
BPMN_TEMPLATE_PATH=statics/bpmn
PROCESS_WITHOUT_FILE_THRESHOLD=0
INVOICE_CRYPTO_SECRET_KEY=CHANGE_ME_RANDOM_32_CHARS
INVOICE_EXPIRY_ALERT_THRESHOLD=7
COMPANY_DISPATCHER_TYPE=company

# Startup super-admin seed. The backend checks this account on every start.
# Use a real mobile number and a strong, unique password before deployment.
SEED_SUPER_ADMIN_ENABLED=true
SEED_SUPER_ADMIN_PHONE=CHANGE_ME_SUPER_ADMIN_PHONE
SEED_SUPER_ADMIN_PASSWORD=CHANGE_ME_STRONG_SUPER_ADMIN_PASSWORD
SEED_SUPER_ADMIN_USERNAME=super-admin
SEED_SUPER_ADMIN_NAME=مدیر
SEED_SUPER_ADMIN_LASTNAME=ارشد سامانه
SEED_SUPER_ADMIN_NATIONAL_CODE=
SEED_SUPER_ADMIN_EMAIL=
# Keep false normally. Set true for one deployment only when resetting the password.
SEED_SUPER_ADMIN_RESET_PASSWORD=false
# Set false for a clean production database without presentation/sample records.
DEMO_SEED_ENABLED=true

# Optional integrations; leave blank only when the corresponding feature is disabled.
SEPIDAR=
SEPIDAR_SERVICE_CODE_COI=
SEPIDAR_SERVICE_CODE_IC=
SEPIDAR_SERVICE_CODE_SAMPLING=
ALLOWED_IPS_PERSONNEL=
IKC_PUBLIC_KEY=
TERMINAL_ID=
ACCEPTOR_ID=
REVERT_URI=
PASS_PHRASE=
SMS_API_KEY=
SMS_URI=
RASMIO_API_KEY=
RASMIO_URL=
CURRENCY_API_KEY=
CURRENCY_API_URL=
CUSTOMER_NAITCO_URL=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_VERIFY_URL=
ELASTIC_API_KEY=
ACTIVITY_CANCEL_STATUS=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_SECURE=false
